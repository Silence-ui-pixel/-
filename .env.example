# 复制为 .env 后按需修改：cp .env.example .env
# .env 不进版本库；本文件里的值只用于本地开发。

# ---- PostgreSQL ----
POSTGRES_DB=canku
POSTGRES_USER=canku
POSTGRES_PASSWORD=canku_dev
# 宿主机端口。若本机已装 PostgreSQL 占用 5432，改成 5433 等
DB_PORT=5432

# ---- API ----
API_PORT=8000
APP_ENV=dev
LOG_LEVEL=DEBUG

# ---- Web（B 的 S1-10 会用到） ----
WEB_PORT=5173
